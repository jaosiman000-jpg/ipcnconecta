rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && ownProfile().status == 'ativo'
        && ownProfile().emailVerified == true;
    }

    function hasRole(roles) {
      return activeUser() && ownProfile().roles.hasAny(roles);
    }

    // Acesso completo: Conselho e Secretaria são equivalentes. `administrador` é um papel
    // antigo mantido até a migração das contas (Configurações > Converter para Conselho).
    function superuser() {
      return hasRole(['administrador', 'conselho', 'secretaria']);
    }

    function memberManager() {
      return superuser();
    }

    // Com o módulo Sociedades em espera, somente o acesso completo consulta o diretório de membros.
    function memberDirectoryReader() {
      return superuser();
    }

    function visitorTeam() {
      return hasRole(['administrador', 'conselho', 'secretaria', 'acolhimento']);
    }

    function ebdManager() {
      return superuser();
    }

    function assignedClass(classId) {
      return hasRole(['professor']) && (
        classId in ownProfile().classIds
        || request.auth.uid in get(/databases/$(database)/documents/ebdClasses/$(classId)).data.teacherIds
      );
    }

    function societyManager() {
      return superuser();
    }

    function societyReader() {
      return superuser();
    }

    function assignedSociety(societyId) {
      return hasRole(['lider']) && (
        societyId in ownProfile().societyIds
        || request.auth.uid in get(/databases/$(database)/documents/societies/$(societyId)).data.leaderIds
      );
    }

    function financeTeam() {
      return hasRole(['administrador', 'conselho', 'secretaria', 'diacono']);
    }

    function validSelfVerification() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'updatedAt'])
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || superuser());
      allow list: if superuser();
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == userId && validSelfVerification();
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if memberManager();
      allow create, update, delete: if false;
    }

    match /memberDirectory/{memberId} {
      allow read: if memberDirectoryReader();
      allow create, update, delete: if false;
    }

    match /memberPrivate/{memberId} {
      allow read: if superuser();
      allow create, update, delete: if false;
    }

    match /visitors/{visitorId} {
      allow read: if visitorTeam();
      allow create, update, delete: if false;
    }

    match /ebdClasses/{classId} {
      allow read: if ebdManager() || assignedClass(classId);
      allow create, update, delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if ebdManager() || assignedClass(resource.data.classId);
      allow create, update, delete: if false;
    }

    match /societies/{societyId} {
      allow read: if societyReader() || assignedSociety(societyId);
      allow create, update, delete: if false;
    }

    match /societyRequests/{requestId} {
      allow read: if societyManager() || (hasRole(['lider']) && resource.data.requestedBy == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /financeEntries/{entryId} {
      allow read: if financeTeam();
      allow create, update, delete: if false;
    }

    match /financeDirectory/{personId} {
      allow read: if financeTeam();
      allow create, update, delete: if false;
    }

    match /ebdDirectory/{personId} {
      allow read: if ebdManager()
        || (hasRole(['professor']) && resource.data.ebd.classId in ownProfile().classIds);
      allow create, update, delete: if false;
    }

    match /financeBatches/{batchId} {
      allow read: if financeTeam();
      allow create, update, delete: if false;
    }

    match /people/{personId} {
      allow read: if memberManager();
      allow create, update, delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if superuser();
      allow create, update, delete: if false;
    }

    match /appSettings/{settingsId} {
      allow read: if activeUser();
      allow create, update, delete: if false;
    }

    match /audit/{eventId} {
      allow read: if superuser();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
