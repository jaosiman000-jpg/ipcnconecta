{
  "name": "ipcn-conecta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev -A vercel.dev.json",
    "build": "tsc -b && npm run check:api && vite build",
    "check:api": "tsc -p tsconfig.api.json",
    "preview": "vite preview",
    "test": "vitest run",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check": "npm run test && npm run test:emulator && npm run build && npm run check:pwa",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-ipcn \"vitest run --config vitest.emulator.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-ipcn",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "dev:emulator": "vite --mode emulator"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.5.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^14.19.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
